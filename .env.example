# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Leave unset for the default: a local SQLite file (data/tradon.db), no
# server needed. Uncomment for Postgres instead (see README "Database setup"):
# DATABASE_URL=postgresql+asyncpg://bot:CHANGE_ME@localhost:5432/trading_bot

# Get a token from @BotFather. Leave TELEGRAM_CHAT_ID empty, start the bot
# (`tradon-telegram`), send /start to it, then paste the chat id it replies
# with here and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signs Web dashboard session cookies — fine as-is for localhost-only use,
# change it in .env for anything else.
WEB_SECRET_KEY=insecure-default-change-me-in-.env

LOG_LEVEL=INFO
